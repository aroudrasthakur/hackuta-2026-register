{
  "name": "hackuta-2026-register",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/ensure-convex-server-stub.mjs && node scripts/verify-production-env.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:verify": "node scripts/verify-convex-deployment.mjs",
    "pretypecheck": "node scripts/ensure-convex-server-stub.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p convex/tsconfig.json --pretty false",
    "lint": "eslint src convex shared security scripts",
    "pretest:unit": "node scripts/ensure-convex-server-stub.mjs",
    "test:unit": "vitest run",
    "pretest:unit:coverage": "node scripts/ensure-convex-server-stub.mjs",
    "test:unit:coverage": "vitest run --coverage",
    "test:coverage:check": "node scripts/check-coverage.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@paper-design/shaders-react": "^0.0.80",
    "convex": "^1.45.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^5.0.1",
    "convex-test": "^0.0.58",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.1.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.0.1"
  }
}
