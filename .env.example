# Copy to .env.local for local development.
# Vercel production: use the commented values below each variable.
# Convex backend vars: set with `npx convex env set --prod` (see README.md).

# === Vercel (frontend build) ===
# All VITE_* vars → Vercel type: Config (public; baked into the browser bundle).

VITE_CONVEX_URL=https://standing-manatee-425.convex.cloud # Config — dev deployment
# VITE_CONVEX_URL=https://brilliant-ostrich-892.convex.cloud # Config — production

VITE_CONVEX_SITE_URL=https://standing-manatee-425.convex.site # Config — dev deployment
# VITE_CONVEX_SITE_URL=https://brilliant-ostrich-892.convex.site # Config — production

VITE_LANDING_URL=http://localhost:5173 # Config
# VITE_LANDING_URL=https://hackuta.com # Config

VITE_USE_MOCK_API=false # Config
# VITE_USE_MOCK_API=false # Config

# === Local / CLI only (do not set on Vercel) ===

CONVEX_DEPLOYMENT=dev:standing-manatee-425 # local only — default dev cloud deployment
# CONVEX_DEPLOYMENT=prod:brilliant-ostrich-892 # local only — production

# === Convex deployment env (npx convex env set) ===
# Never set these as VITE_* or on Vercel.
#
# Dev deployment (standing-manatee-425):
#   node scripts/generateAuthKeys.mjs          # JWT_PRIVATE_KEY + JWKS (dev only)
#   node scripts/sync-dev-convex-env.mjs       # SMTP/email from prod + localhost origins
# Or set manually:
#   npx convex env set SITE_URL http://127.0.0.1:5273
#   npx convex env set REGISTRATION_ALLOWED_ORIGINS "http://127.0.0.1:5273,http://localhost:5273"
#   npx convex env set REGISTRATION_ALLOW_LOCAL_DEV_ORIGINS true
#
# Prod deployment (brilliant-ostrich-892) — register.hackuta.com only:
#   npx convex env set --prod SITE_URL https://register.hackuta.com
#   npx convex env set --prod REGISTRATION_ALLOWED_ORIGINS https://register.hackuta.com
#   npx convex env unset --prod REGISTRATION_ALLOW_LOCAL_DEV_ORIGINS

# REGISTRATION_ADMIN_IDENTITY_KEYS=provider|organizer-token-id # Secret

# JWT_PRIVATE_KEY= # Secret — node scripts/generateAuthKeys.mjs
# JWKS= # Secret

# SMTP_HOST= # Config
# SMTP_PORT=465 # Config
# SMTP_USER=noreply@hackuta.org # Config
# SMTP_PASSWORD= # Secret
# EMAIL_FROM=noreply@hackuta.org # Config
# CONTACT_EMAIL_TO=hello@hackuta.org # Config
