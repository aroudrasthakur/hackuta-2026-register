{
  "check-coverage": true,
  "lines": 80,
  "functions": 80,
  "branches": 80,
  "statements": 80,
  "include": [
    "src/**/*.{ts,tsx}",
    "shared/**/*.ts",
    "convex/**/*.ts",
    "security/**/*.ts"
  ],
  "exclude": [
    "src/main.tsx",
    "**/*.test.*",
    "**/*.spec.*",
    "convex/_generated/**",
    "convex/crons.ts",
    "src/components/**",
    "src/constants/images.ts",
    "src/convex/client.ts",
    "src/pages/Register/RegisterPage.tsx"
  ],
  "reporter": ["text-summary", "text"],
  "temp-dir": ".nyc_output"
}
